# ---------------------------------------------------------------------------
# RevenueOS environment
#
# Copy to .env and fill in. The Anthropic key is read by the BACKEND only —
# it is never sent to the browser and never appears in the client bundle.
# ---------------------------------------------------------------------------

# --- AI (optional) ---------------------------------------------------------
# Without a key every analytical feature still works: all scores, segments,
# matches and opportunities are deterministic. The key adds written narration
# (AI Analyst prose, daily briefing, weekly review, campaign copy).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2000

# --- Storage ---------------------------------------------------------------
# Where the SQLite database and cached tables live.
REVENUEOS_DATA_DIR=./backend/var
REVENUEOS_DB_NAME=revenueos.db

# --- Locale ----------------------------------------------------------------
REVENUEOS_CURRENCY=EUR
REVENUEOS_LOCALE=it-IT

# --- Privacy ---------------------------------------------------------------
# When true (default), email addresses, phone numbers and free-text notes are
# stripped from every payload sent to the LLM.
REVENUEOS_MINIMISE_PII=true

# --- Networking ------------------------------------------------------------
REVENUEOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by the Next.js server to reach the API (never exposed to the browser).
API_URL=http://127.0.0.1:8000
