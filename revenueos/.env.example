# ─── Backend ────────────────────────────────────────────────────────────────
# Server-side only. Enables the conversational AI Analyst and AI narratives.
# Everything else (analytics, matching, opportunities, performance) works
# without it. Never commit a real key — set it in the host's dashboard.
ANTHROPIC_API_KEY=

# Comma-separated origins allowed to call the API from a browser directly.
# Optional in a normal deployment: the frontend proxies /api server-side, so the
# browser is always same-origin and never triggers a CORS check.
# A bare hostname is accepted and assumed to be https.
CORS_ORIGINS=http://localhost:3000

# Load the demo boutique when there is no saved workspace to restore.
# Intended for hosts with an ephemeral filesystem, where the snapshot is lost on
# every deploy. Leave unset locally to start empty and import your own data.
SEED_DEMO_ON_EMPTY=

# Port to bind. Hosting platforms assign this; locally it defaults to 8000.
PORT=

# ─── Frontend ───────────────────────────────────────────────────────────────
# Where the frontend forwards /api, as a full origin. Used by docker compose.
BACKEND_URL=http://backend:8000

# Alternative to BACKEND_URL: a bare hostname, assumed to be https. Render sets
# this automatically from the API service, so there is no URL to keep in sync.
# BACKEND_HOST=revenueos-api.onrender.com
